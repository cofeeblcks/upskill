# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Clave "anon" JWT (suele empezar por eyJ...). Si ves "Invalid API key" en el navegador,
# suele ser porque aquí pusiste la service_role o una clave incorrecta.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key

# Server-only: rutas /api/* y lecturas servidor (bypass RLS). Nunca en NEXT_PUBLIC_*.
# Debe ser la clave «service_role» del panel (JWT eyJ… o el secreto de servidor que indique Supabase).
# No uses sb_publishable_… ni la misma clave que NEXT_PUBLIC_SUPABASE_ANON_KEY: con RLS sin políticas
# el login devolverá «Credenciales incorrectas» aunque email y contraseña sean correctos.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
